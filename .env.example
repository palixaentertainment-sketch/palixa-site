NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Paystack test checkout only. Never use a live secret for this feature.
# Set PAYSTACK_TEST_MODE=true and use a secret beginning with sk_test_.
PAYSTACK_TEST_MODE=false
PAYSTACK_SECRET_KEY=

# Server-only 32-byte AES-256 key for encrypting author payout account numbers.
# Generate with: openssl rand -hex 32
# Never expose this value with a NEXT_PUBLIC_ prefix.
PAYOUT_DETAILS_ENCRYPTION_KEY=
